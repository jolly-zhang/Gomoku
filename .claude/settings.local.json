{
  "permissions": {
    "allow": [
      "Bash(xcodebuild -version)",
      "Bash(swift --version)",
      "Bash(xcrun simctl *)",
      "Bash(swift test *)",
      "Bash(xcrun --show-sdk-path)",
      "Read(//Library/Developer/CommandLineTools/SDKs/**)",
      "Bash(swift run *)",
      "Bash(npm --version)",
      "Bash(npx --version)",
      "Bash(mkdir -p _legacy_swift)",
      "Bash(mv Package.swift Sources .build _legacy_swift/)",
      "Bash(npm view *)",
      "Read(//private/tmp/**)",
      "Bash(rm -rf gomoku-scaffold)",
      "Bash(npx --yes create-expo-app@latest gomoku-scaffold --template default --no-install)",
      "WebFetch(domain:docs.expo.dev)",
      "Bash(curl -sL --max-time 30 \"https://docs.expo.dev/router/deploying-to-vercel.md\" -o vercel-doc.md)",
      "Bash(curl -sL --max-time 30 \"https://docs.expo.dev/router/reference/static-rendering.md\" -o static-rendering.md)",
      "Bash(curl -sL --max-time 40 \"https://docs.expo.dev/llms.txt\" -o llms.txt)",
      "Bash(curl -sL --max-time 40 \"https://docs.expo.dev/router/web/static-rendering.md\" -o static-rendering.md)",
      "Bash(curl -sL --max-time 40 \"https://docs.expo.dev/deploy/web.md\" -o deploy-web.md)",
      "Bash(curl -sL --max-time 40 \"https://docs.expo.dev/versions/latest/config/app.md\" -o config-app.md)",
      "Bash(cp /tmp/gomoku-scaffold/tsconfig.json ./tsconfig.json)",
      "Bash(cp -r /tmp/gomoku-scaffold/assets ./assets)",
      "Bash(npm install *)",
      "Bash(npx expo *)",
      "Bash(npx vitest *)",
      "Bash(npx tsc *)",
      "Bash(echo \"=== tsc exit: $? ===\")",
      "Bash(curl -sL --max-time 40 \"https://docs.expo.dev/versions/v58.0.0/sdk/audio.md\" -o audio.md)",
      "Bash(node scripts/generate-sounds.mjs)"
    ]
  }
}
